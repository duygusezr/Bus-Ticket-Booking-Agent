# Bus Ticket Booking Agent — Environment Variables
# Bu dosyayı kopyalayıp .env olarak kaydedin:
#   cp .env.example .env

# ── Zorunlu ───────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── İsteğe Bağlı ──────────────────────────────────────────────
# Gemini model seçimi (varsayılan: gemini-2.5-flash)
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Varsayılan konuşma dili: tr | en
DEFAULT_LANG=tr

# Backend portu
PORT=8001

# CORS — Production'da mutlaka kısıtlayın:
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# Geliştirme ortamında * kabul edilebilir:
CORS_ORIGINS=*
