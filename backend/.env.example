# Bus Ticket Booking Agent — Environment Variables
# Bu dosyayı kopyalayıp .env olarak kaydedin:
#   cp .env.example .env

# ── Zorunlu ───────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs STT (konuşma tanıma) için gerekli — yoksa Gemini fallback kullanılır
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Gemini STT fallback — ElevenLabs başarısız olduğunda devreye girer
GEMINI_API_KEY=your_gemini_api_key_here

# ── İsteğe Bağlı ──────────────────────────────────────────
# OpenAI model seçimi (varsayılan: gpt-4.1-mini)
OPENAI_CHAT_MODEL=gpt-4.1-mini

# ElevenLabs STT model (varsayılan: scribe_v2)
ELEVENLABS_STT_MODEL=scribe_v2

# Gemini STT model (varsayılan: gemini-2.5-flash)
GEMINI_STT_MODEL=gemini-2.5-flash

# Varsayılan konuşma dili: tr | en
DEFAULT_LANG=tr

# Backend portu
PORT=8001

# CORS — Production'da mutlaka kısıtlayın:
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# Geliştirme ortamında * kabul edilebilir:
CORS_ORIGINS=*

# ── PostgreSQL (Opsiyonel) ─────────────────────────────────────
# Dual-write: SQLite + PostgreSQL paralel yazma.
# Tanımlı değilse sadece SQLite + CSV kullanılır.
# Local:    postgresql://postgres:sifre@localhost:5432/bus_ticket
# Neon:     postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
# Railway:  $DATABASE_URL (otomatik atanır)
DATABASE_URL=
